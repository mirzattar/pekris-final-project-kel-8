{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Report",
	"type": "object",
	"properties": {
		"id": {
			"title": "ID",
			"type": "string",
			"pattern": "report-.+"
		},
		"title": {
			"title": "Title",
			"type": "string"
		},
		"description": {
			"type": "string"
		},
		"type": {
			"type": "string",
			"oneOf": [
				{
					"const": "LOST"
				},
				{
					"const": "FOUND"
				}
			]
		},
		"category": {
			"type": "string"
		},
		"location": {
			"type": "string"
		},
		"incidentDate": {
			"type": "string"
		},
		"imageUrl": {
			"type": "string",
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "string"
				}
			]
		},
		"reporterId": {
			"type": "string",
			"pattern": "user-.+"
		},
		"contactMethod": {
			"type": "string"
		},
		"createdAt": {
			"type": "string",
			"pattern": "\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[1-2]\\d|3[0-1])T(?:[0-1]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+|)(?:Z|(?:\\+|\\-)(?:\\d{2}):?(?:\\d{2}))"
		},
		"status": {
			"type": "string",
			"oneOf": [
				{
					"const": "ACTIVE"
				},
				{
					"const": "RESOLVED"
				}
			]
		}
	},
	"required": [
		"id",
		"title",
		"description",
		"type",
		"category",
		"location",
		"incidentDate",
		"imageUrl",
		"reporterId",
		"contactMethod",
		"createdAt",
		"status"
	]
}
